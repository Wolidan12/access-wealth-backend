# Comma-separated browser origins. Trailing slashes are accepted; include
# every deployed frontend hostname (for example www and non-www if both are used).
FRONTEND_URL=https://accesswealthhq.com,https://www.accesswealthhq.com,http://localhost:3000
APP_TIME_ZONE=Africa/Lagos
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_admin_password
SUPPORT_BOOTSTRAP_PASSWORD=replace_with_secure_support_password
PORT=3000
NODE_ENV=production

