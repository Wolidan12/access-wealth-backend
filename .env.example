JWT_SECRET=replace_with_secure_jwt_secret
# Comma-separated browser origins. Trailing slashes are accepted; include
# every deployed frontend hostname (for example www and non-www if both are used).
FRONTEND_URL=https://accesswealthhq.com,https://www.accesswealthhq.com,http://localhost:3000
APP_TIME_ZONE=Africa/Lagos
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_admin_password
SUPPORT_BOOTSTRAP_PASSWORD=replace_with_secure_support_password
PORT=3000
NODE_ENV=production

# ==========================================
# MANUAL PAYMENT CONFIG
# Deposits are handled manually: users transfer to this account and upload a
# receipt for admin approval.
# ==========================================
MANUAL_PAYMENT_ENABLED=true
MANUAL_BANK_NAME=Moniepoint
MANUAL_ACCOUNT_NAME=Luna Entry Services - Access Wealth HQ
MANUAL_ACCOUNT_NUMBER=6977298247
MANUAL_BANK_CODE=
MANUAL_CURRENCY=NGN
MANUAL_PAYMENT_INSTRUCTIONS=Transfer the deposit amount to the account below, then upload your payment receipt to complete the request. Your deposit will be credited to your wallet once an admin approves it.

# ==========================================
# WEB PUSH (VAPID)
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave unset to run with push notifications disabled (app hides the toggle).
# ==========================================
VAPID_PUBLIC_KEY=generate_vapid_public_key
VAPID_PRIVATE_KEY=generate_vapid_private_key
VAPID_SUBJECT=mailto:support@accesswealthhq.com

# ==========================================
# TRANSACTIONAL EMAIL
# Without these, email is disabled safely (welcome/verification/reset and
# approval emails are skipped with a log line; forgot/reset-password answer a
# clear 501 JSON). MAIL_TRANSPORT=json renders emails without sending (dev).
# ==========================================
MAIL_TRANSPORT=
MAIL_FROM=Access Wealth HQ <no-reply@accesswealthhq.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# MAIL_ENABLED=false forces email off even when SMTP_* are set.
MAIL_ENABLED=
